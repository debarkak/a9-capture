<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Direct Hardware SurfaceView for USB Capture Card -->
    <SurfaceView
        android:id="@+id/surfaceView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- CameraX PreviewView (Fallback) -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:implementationMode="performance"
        app:scaleType="fitCenter"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Disconnected / No Capture Card Empty State -->
    <LinearLayout
        android:id="@+id/layoutDisconnected"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:background="@drawable/bg_glass_card"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/ivUsbIcon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_usb"
            app:tint="@color/cyan_accent" />

        <TextView
            android:id="@+id/tvDisconnectTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/title_disconnected"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <TextView
            android:id="@+id/tvDisconnectSubtitle"
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/subtitle_connect_prompt"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:gravity="center" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnScanDevices"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:text="@string/btn_refresh"
            android:textColor="@color/bg_dark"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@color/cyan_accent"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_refresh"
            app:iconTint="@color/bg_dark" />
    </LinearLayout>

    <!-- Top HUD Overlay Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/hudOverlay"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Left: Status Badges -->
        <LinearLayout
            android:id="@+id/badgeContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <!-- Device Name Badge -->
            <TextView
                android:id="@+id/tvDeviceBadge"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_pill_badge"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="USB HDMI"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- FPS Badge -->
            <TextView
                android:id="@+id/tvFpsBadge"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill_badge"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="90 FPS"
                android:textColor="@color/emerald_accent"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Resolution Badge -->
            <TextView
                android:id="@+id/tvResolutionBadge"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill_badge"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="1920x1200 @ 90Hz"
                android:textColor="@color/cyan_accent"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Aspect Ratio Badge -->
            <TextView
                android:id="@+id/tvAspectBadge"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill_badge"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="16:10 FULL"
                android:textColor="@color/amber_accent"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Right: Action Buttons -->
        <LinearLayout
            android:id="@+id/actionContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Audio Passthrough Toggle -->
            <ImageButton
                android:id="@+id/btnAudioToggle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_button"
                android:src="@drawable/ic_volume_off"
                app:tint="@color/text_primary"
                android:contentDescription="Audio Toggle" />

            <!-- Aspect Ratio Button -->
            <ImageButton
                android:id="@+id/btnAspectToggle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_icon_button"
                android:src="@drawable/ic_aspect_ratio"
                app:tint="@color/text_primary"
                android:contentDescription="Aspect Ratio" />

            <!-- Snapshot / Screenshot Button -->
            <ImageButton
                android:id="@+id/btnSnapshot"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_icon_button"
                android:src="@drawable/ic_camera"
                app:tint="@color/text_primary"
                android:contentDescription="Take Snapshot" />

            <!-- Settings Button -->
            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_icon_button"
                android:src="@drawable/ic_settings"
                app:tint="@color/text_primary"
                android:contentDescription="Settings" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
